# ==============================================================================
# AI Social Media Agent — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
APP_NAME="AI Social Media Agent"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (Default: local SQLite database)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/social_agent
DATABASE_URL=sqlite:///./social_agent.db

# Security & Encryption (Fernet Token Encryption)
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NOTE: The default key below is provided ONLY for local development sandbox convenience.
# Production environments MUST set a unique cryptographically generated key.
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars!
FERNET_KEY=k8zZ01Ua9qL_Wc4z7d_YxG8jB2nF6mP0rT3vA5eC7sI=

# Mock & Sandbox Operation Modes (Default: true for zero-dependency local runs)
MOCK_SOCIAL_PUBLISHING=true
SLACK_MOCK_MODE=true

# LLM Provider Configuration
# Active provider: "gemini", "groq", or "mock"
# When API keys are blank, the system automatically falls back to the intelligent MockProvider
LLM_PROVIDER=mock

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI Quality Review & Self-Correction Thresholds
AI_QUALITY_THRESHOLD=70
AI_MAX_CORRECTION_ATTEMPTS=2

# Slack Integration (Optional in development; mock mode enabled by default)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#social-approvals

# Social Media OAuth Credentials (Optional; mock publisher operates without credentials)
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
